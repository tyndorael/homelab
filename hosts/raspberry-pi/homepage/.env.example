TZ=Etc/UTC
PUID=1000
PGID=1000
DOMAIN=home.example.com
# Comma-separated host[:port] values Homepage will answer to (homepage:3000 = in-network checks, e.g. Glance).
HOMEPAGE_ALLOWED_HOSTS=home.example.com,192.168.1.10:3000,homepage:3000
HOMEPAGE_BIND=0.0.0.0
PI_IP=192.168.1.10
UNRAID_IP=192.168.1.20
MAC_IP=192.168.1.30
HA_IP=192.168.1.21

# --- Widget credentials (use dedicated low-privilege accounts, never your admin login) ---
# NPM: Users -> Add user, permissions "View Only" for everything.
NPM_USERNAME=
NPM_PASSWORD=
# Portainer: My account -> Access tokens -> Add. ENV = the number in the URL of the local
# environment (…/#!/3/docker/dashboard -> 3).
PORTAINER_ENV=3
PORTAINER_KEY=
# AdGuard Home has a single user type; reuse its login or add a second user in AdGuardHome.yaml.
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
# Unraid (7.2+): Settings -> Management Access -> API Keys -> Create, role VIEWER (read-only).
# Homepage's docs ask for ADMIN, but VIEWER returns every field the widget queries (tested on 7.3.3).
UNRAID_KEY=
# Home Assistant: create a dedicated non-admin user `homepage`, log in as it, Profile -> Security
# -> Long-lived access tokens -> Create.
HA_TOKEN=
