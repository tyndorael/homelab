TZ=Etc/UTC
# Name shown for this Docker host in the Dozzle UI
HOST_LABEL=cyrene
# simple = login from ./data/users.yml (generate it first, see hosts/raspberry-pi/README.md)
DOZZLE_AUTH_PROVIDER=simple
DOZZLE_BIND=0.0.0.0
# Dozzle agents on other hosts: host:7007|label, comma-separated
REMOTE_AGENTS=192.168.1.30:7007|mac-mini
