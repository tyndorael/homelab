TZ=Etc/UTC
TS_HOSTNAME=cyrene
# LAN subnet advertised to the tailnet (approve it in the admin console).
TS_ROUTES=192.168.50.0/24
# One-off auth key for the first login (admin console -> Settings -> Keys -> Generate auth key,
# not reusable). Can be removed after the node is registered.
TS_AUTHKEY=
# e.g. --advertise-exit-node to also use the Pi as an exit node
TS_EXTRA_ARGS=
