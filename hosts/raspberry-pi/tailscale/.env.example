TZ=Etc/UTC
TS_HOSTNAME=cyrene
# LAN subnet advertised to the tailnet (approve it in the admin console).
TS_ROUTES=192.168.50.0/24
# Optional pre-auth key (tskey-auth-...). Empty = log in via the URL printed in the logs.
TS_AUTHKEY=
# e.g. --advertise-exit-node to also use the Pi as an exit node
TS_EXTRA_ARGS=
