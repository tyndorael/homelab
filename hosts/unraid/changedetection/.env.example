TZ=Etc/UTC
# Unraid defaults: nobody:users (changedetection runs as this user; pre-create ./data with this owner)
PUID=99
PGID=100
CHANGEDETECTION_PORT=5000
# Public URL, used for links in notifications
BASE_URL=https://changes.example.duckdns.org
# Parallel page fetches, and Chrome instances the browser container may run at once
FETCH_WORKERS=5
MAX_CONCURRENT_CHROME_PROCESSES=4
