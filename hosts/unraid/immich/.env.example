TZ=Etc/UTC
# Unraid defaults: nobody:users (all four containers run as this user)
PUID=99
PGID=100
# Originals (library, uploads, encoded video, automatic DB dumps in backups/). Array share, not the DB.
UPLOAD_LOCATION=/mnt/user/data/photos
# Postgres password: letters and digits only (openssl rand -hex 24)
DB_PASSWORD=changeme
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# GPU for transcoding + ML: all, or a UUID from `nvidia-smi -L`
NVIDIA_VISIBLE_DEVICES=all
